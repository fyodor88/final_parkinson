# ==============================================================================
# ParkinSense — Unified Environment Configuration
# ==============================================================================

# Backend Server Configuration
PORT=5001
FLASK_ENV=production

# Default Pipeline Mode: "mediapipe" | "fourd_humans"
# Can be overridden per request via UI selector or ?pipeline= query parameter
PIPELINE_MODE=mediapipe

# ------------------------------------------------------------------------------
# 4D-Humans / HMR2 GPU Configuration
# ------------------------------------------------------------------------------
# 4D-Humans requires Linux with CUDA for real GPU mesh reconstruction.
# When running on macOS M1, requests are dispatched to a remote Ubuntu GPU server.
#
# Pose Service Execution Mode:
#   "ssh"   - Run 4D-Humans remotely on the Ubuntu GPU machine via SSH/SCP.
#             (Raises GPUServiceUnavailableError if host is unreachable)
#   "local" - Run 4D-Humans locally via track.py (Linux/CUDA environments only)
#   "mock"  - Deterministic SMPL dynamics baseline for offline/unit testing
#   "auto"  - Try ssh -> local -> mock (development convenience)
POSE_SERVICE_MODE=ssh

# Remote SSH GPU Machine Settings (e.g., Ubuntu RTX 2050 laptop)
FOURD_HUMANS_SSH_HOST=10.40.16.253
FOURD_HUMANS_SSH_USER=pranav
FOURD_HUMANS_SSH_KEY=
FOURD_HUMANS_SSH_PORT=22
FOURD_HUMANS_REMOTE_DIR=~/ParkinSense/4D-Humans
FOURD_HUMANS_REMOTE_TEMP=/tmp/parkinsense_jobs

# Local 4D-Humans Installation Path (if executing locally)
FOURD_HUMANS_ROOT=4D-Humans

# ------------------------------------------------------------------------------
# Machine Learning Models (Locked Production Assets)
# ------------------------------------------------------------------------------
# Both MediaPipe and 4D-Humans pipelines feed into these centralized models
MODEL_PATH=models/pd_detector.pkl
SEVERITY_MODEL_PATH=models/random_forest.pkl

# Directory Paths
UPLOAD_DIR=uploads
OUTPUT_DIR=remote_output
STATIC_GAIT_FRAMES_DIR=static/gait_frames
