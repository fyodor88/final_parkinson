# ParkinSense Configuration Settings

# Web API Server Port
PORT=5001

# Pose Extraction Service
POSE_SERVICE_MODE=local

# SSH settings (only needed for remote GPU processing)
FOURD_HUMANS_SSH_HOST=
FOURD_HUMANS_SSH_USER=
FOURD_HUMANS_SSH_KEY=
FOURD_HUMANS_SSH_PORT=22
FOURD_HUMANS_REMOTE_DIR=
FOURD_HUMANS_REMOTE_TEMP=/tmp/parkinsense_jobs

# Paths
MODEL_PATH=models/pd_detector.pkl
SEVERITY_MODEL_PATH=models/random_forest.pkl
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
